---
import Base from '../layouts/Base.astro';
import ClayArt from '../components/ClayArt.astro';
---
<Base title="Page not found" noindex>
  <section class="wrap nf">
    <div class="clay box">
      <div class="nf-art"><ClayArt name="qubit" /></div>
      <p class="code" aria-hidden="true">404</p>
      <h1>This page does not exist</h1>
      <p class="muted">The link may be old, or the address has a typo. Try one of these instead.</p>
      <div class="links">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn" href="/blog/">Read the blog</a>
        <a class="btn" href="/publications/">See publications</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(48px, 10vw, 120px) 0; }
  .box { padding: clamp(28px, 6vw, 64px); border-radius: var(--r-xl); text-align: center; }
  .nf-art { width: 150px; margin: 0 auto 8px; }
  .code { font-size: clamp(4rem, 3rem + 8vw, 9rem); font-weight: 800; line-height: 1; margin: 0; color: var(--primary); text-shadow: 6px 8px 0 var(--surface-2); }
  h1 { font-size: var(--step-3); margin-inline: auto; }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 24px; }
</style>
