---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ClayArt from '../../components/ClayArt.astro';
import { artFor, formatDate, getPosts, readingTime, slugifyTag, type Post } from '../../scripts/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => {
    const tags = new Set(post.data.tags);
    const related = posts
      .filter((p) => p.id !== post.id)
      .map((p) => ({ p, s: p.data.tags.filter((t) => tags.has(t)).length + (p.data.category === post.data.category ? 0.5 : 0) }))
      .sort((a, b) => b.s - a.s)
      .slice(0, 3)
      .map((x) => x.p);
    return { params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1], related } };
  });
}

interface Props { post: Post; newer?: Post; older?: Post; related: Post[] }
const { post, newer, older, related } = Astro.props;
const url = new URL(`/blog/${post.id}/`, Astro.site).toString();
const enc = encodeURIComponent;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const { title, description, date, updated, category, tags, demo } = post.data;
---
<Base title={title} description={description} type="article">
  <div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>
  <article class="wrap post">
    <header class="post-head">
      <a class="back" href="/blog/"><Icon name="arrowLeft" /> All posts</a>
      <div class="chips">
        <span class={`chip ${category === 'Research' ? 'tag-mint' : 'tag-butter'}`}>{category}</span>
        {demo && <span class="chip">Demo</span>}
      </div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="info">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <>, updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
        , {readingTime(post.body)} min read
      </p>
    </header>

    <div class="layout">
      {toc.length > 1 && (
        <aside class="toc-wrap">
          <details class="toc clay-sm" open>
            <summary>On this page</summary>
            <ol>
              {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </details>
        </aside>
      )}
      <div class="body clay">
        <div class="prose"><Content /></div>

        <footer class="post-foot">
          {tags.length > 0 && (
            <ul class="chips" aria-label="Tags">
              {tags.map((t) => <li><a class="chip" href={`/blog/tags/${slugifyTag(t)}/`}>#{t}</a></li>)}
            </ul>
          )}
          <div class="share">
            <a class="btn btn-sm" href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`} rel="noopener" target="_blank">Share on LinkedIn</a>
            <a class="btn btn-sm" href={`https://x.com/intent/post?url=${enc(url)}&text=${enc(title)}`} rel="noopener" target="_blank">Share on X</a>
            <button type="button" class="btn btn-sm" id="share"><Icon name="link" /> Copy link</button>
          </div>
        </footer>
      </div>
    </div>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-h">
        <h2 id="related-h">Keep reading</h2>
        <ul class="rel-list">
          {related.map((p) => (
            <li>
              <a class="rel clay-sm" href={`/blog/${p.id}/`}>
                <span class={`rel-art rel-${p.data.category.toLowerCase()}`}><ClayArt name={artFor(p)} /></span>
                <span class="rel-text">
                  <span class="rel-meta">{p.data.category}, {readingTime(p.body)} min read</span>
                  <span class="rel-title">{p.data.title}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <nav class="pager" aria-label="More posts">
      {older ? <a class="clay-sm" href={`/blog/${older.id}/`}><span class="muted">Older</span>{older.data.title}</a> : <span />}
      {newer && <a class="clay-sm next" href={`/blog/${newer.id}/`}><span class="muted">Newer</span>{newer.data.title}</a>}
    </nav>
  </article>
</Base>

<style>
  .post-head { padding-top: clamp(32px, 6vw, 70px); max-width: 860px; }
  .post-head h1 { font-size: var(--step-3); margin-top: 18px; }
  .back { display: inline-flex; align-items: center; gap: 8px; font-weight: 650; margin-bottom: 22px; text-decoration: none; }
  .back :global(svg) { width: 18px; height: 18px; }
  .info { font-weight: 600; color: var(--ink-soft); font-size: var(--step--1); }
  ul.chips { list-style: none; padding: 0; margin: 0; }

  .post { max-width: 1320px; }
  .layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 28px; margin-top: 28px; align-items: start; }
  .layout:not(:has(.toc-wrap)) { grid-template-columns: minmax(0, 1fr); }
  .toc-wrap { position: sticky; top: 110px; }
  .toc { padding: 18px 20px; }
  .toc summary { font-weight: 750; cursor: pointer; }
  .toc ol { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 6px; }
  .toc a { color: var(--ink-soft); text-decoration: none; font-size: var(--step--1); font-weight: 600; display: block; padding: 3px 0; }
  .toc a:hover, .toc a.active { color: var(--primary); }
  .toc .d3 { padding-left: 14px; }
  .body { padding: clamp(18px, 4vw, 44px); border-radius: var(--r-xl); min-width: 0; }
  .body :global(.prose .figure) { padding: clamp(14px, 2vw, 24px); }
  .post-foot { margin-top: 40px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; align-items: center; }

  .progress { position: fixed; top: 0; left: 0; right: 0; height: 5px; z-index: 60; pointer-events: none; }
  .progress span { display: block; height: 100%; width: 100%; transform-origin: 0 50%; transform: scaleX(0); background: var(--primary); border-radius: 0 4px 4px 0; }
  .share { display: flex; flex-wrap: wrap; gap: 10px; }
  .related { margin-top: 48px; }
  .related h2 { font-size: var(--step-1); margin-bottom: 16px; }
  .rel-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  .rel { display: flex; align-items: center; gap: 14px; padding: 12px 18px 12px 12px; border-radius: var(--r-md); color: var(--ink); text-decoration: none; transition: transform .15s ease; }
  .rel:hover { transform: translateY(-2px); color: var(--ink); }
  .rel:active { box-shadow: var(--clay-pressed); transform: none; }
  .rel-art { flex: none; width: 60px; height: 60px; border-radius: 16px; display: grid; place-items: center; padding: 6px; box-shadow: var(--clay-pressed); }
  .rel-research { background: color-mix(in srgb, var(--mint) 30%, var(--surface-2)); }
  .rel-technical { background: color-mix(in srgb, var(--butter) 30%, var(--surface-2)); }
  .rel-text { display: grid; gap: 2px; min-width: 0; }
  .rel-meta { font-size: 12.5px; font-weight: 600; color: var(--ink-soft); }
  .rel-title { font-weight: 700; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .rel:hover .rel-title { color: var(--primary); }
  .prose :global(.code-wrap) { position: relative; }
  .prose :global(.code-wrap > pre) { margin-top: 0; }
  .prose :global(.code-title) { font: 600 12.5px/1.3 var(--font-code); color: var(--ink-soft); background: var(--surface-2); padding: 10px 16px; border-radius: var(--r-md) var(--r-md) 0 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-right: 96px; }
  .prose :global(.code-wrap.has-title > pre) { border-top-left-radius: 0; border-top-right-radius: 0; }
  .prose :global(.code-wrap.has-title .copy-code) { top: 3px; }
  .prose :global(.copy-code) { position: absolute; top: 8px; right: 8px; z-index: 1; min-height: 32px; padding: 4px 12px; font-size: 13px; opacity: 0; transition: opacity .15s; }
  .prose :global(.code-wrap:hover .copy-code), .prose :global(.copy-code:focus-visible) { opacity: 1; }
  @media (hover: none) { .prose :global(.copy-code) { opacity: 1; } }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 36px; }
  .pager a { display: grid; gap: 4px; padding: 18px 22px; text-decoration: none; color: var(--ink); font-weight: 700; }
  .pager a span { font-size: var(--step--1); font-weight: 600; }
  .pager .next { text-align: right; grid-column: 2; }

  @media (max-width: 1200px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .toc-wrap { position: static; }
    .toc { max-width: 560px; }
  }
  @media (max-width: 560px) {
    .pager { grid-template-columns: 1fr; }
    .pager .next { grid-column: 1; text-align: left; }
  }
</style>

<script>
  // Close the TOC by default on small screens.
  const toc = document.querySelector<HTMLDetailsElement>('.toc');
  if (toc && matchMedia('(max-width: 1200px)').matches) toc.open = false;

  // Highlight the section currently in view.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[];
  if ('IntersectionObserver' in window && targets.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) links.forEach((a) => a.classList.toggle('active', a.hash === `#${e.target.id}`));
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    targets.forEach((t) => io.observe(t));
  }

  // Reading progress
  const bar = document.getElementById('progress-bar');
  const art = document.querySelector('.post .body') as HTMLElement | null;
  const prog = () => {
    if (!bar || !art) return;
    const r = art.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (r.height + innerHeight * 0.2)));
    bar.style.transform = `scaleX(${p})`;
  };
  addEventListener('scroll', prog, { passive: true }); prog();

  // Copy buttons on every code block
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'btn btn-sm copy-code'; b.textContent = 'Copy';
    b.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText ?? pre.innerText;
      try { await navigator.clipboard.writeText(code); b.textContent = 'Copied'; }
      catch { b.textContent = 'Select and copy'; }
      setTimeout(() => (b.textContent = 'Copy'), 1600);
    });
    const wrap = document.createElement('div');
    wrap.className = 'code-wrap';
    pre.parentNode?.insertBefore(wrap, pre);
    if (pre.dataset.title) {
      const bar = document.createElement('div');
      bar.className = 'code-title';
      bar.textContent = pre.dataset.title;
      wrap.classList.add('has-title');
      wrap.appendChild(bar);
    }
    wrap.appendChild(pre);
    wrap.appendChild(b);
  });

  const share = document.getElementById('share');
  share?.addEventListener('click', async () => {
    const original = share.innerHTML;
    try {
      if (navigator.share && matchMedia('(pointer: coarse)').matches) await navigator.share({ title: document.title, url: location.href });
      else { await navigator.clipboard.writeText(location.href); share.textContent = 'Link copied'; }
    } catch { /* user cancelled */ }
    setTimeout(() => (share.innerHTML = original), 1800);
  });
</script>
