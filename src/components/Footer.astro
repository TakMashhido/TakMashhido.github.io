---
import Icon from './Icon.astro';
import { nav, site, socials } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot clay">
      <div class="who">
        <p class="name">{site.name}</p>
        <p class="muted">{site.role}</p>
        <a class="mail" href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a>
      </div>
      <nav aria-label="Footer">
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <ul class="social">
        {socials.map((s) => <li><a class="chip" href={s.href} rel="me noopener">{s.label}</a></li>)}
        <li><a class="chip" href="/rss.xml"><Icon name="rss" /> RSS</a></li>
      </ul>
    </div>
    <p class="fine muted">© {year} {site.name}.</p>
  </div>
</footer>

<style>
  .site-footer { padding-block: clamp(56px, 9vw, 110px) 24px; }
  .foot {
    display: grid; gap: 28px; padding: clamp(24px, 4vw, 40px);
    grid-template-columns: 1.3fr 1fr 1fr; border-radius: var(--r-xl);
  }
  .name { font-size: var(--step-1); font-weight: 750; margin-bottom: 4px; }
  .mail { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; word-break: break-all; }
  .mail :global(svg) { width: 18px; height: 18px; flex: none; }
  ul { list-style: none; margin: 0; padding: 0; }
  nav ul { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px; }
  nav a { color: var(--ink); text-decoration: none; font-weight: 600; display: inline-block; padding: 6px 0; }
  nav a:hover { color: var(--primary); }
  .social { display: flex; flex-wrap: wrap; gap: 10px; align-content: start; }
  .social :global(svg) { width: 15px; height: 15px; }
  .fine { font-size: var(--step--1); margin: 18px 6px 0; }
  @media (max-width: 820px) { .foot { grid-template-columns: 1fr; } }
</style>
