---
import sim from '../../data/puf-sim.json';
// Modelling-attack accuracy vs number of collected CRPs (log x axis).
const W = 760, H = 330, L = 56, R = 120, T = 20, B = 56;
const pw = W - L - R, ph = H - T - B;
const xs = sim.attack.map((a) => a.crps);
const lx0 = Math.log10(xs[0]), lx1 = Math.log10(xs[xs.length - 1]);
const x = (n: number) => L + ((Math.log10(n) - lx0) / (lx1 - lx0)) * pw;
const y = (v: number) => T + ph - ((v - 0.4) / 0.6) * ph;
const series = [
  { key: 'arbiter' as const, name: 'Arbiter PUF', color: 'var(--s1)' },
  { key: 'xor4' as const, name: '4-XOR arbiter PUF', color: 'var(--s2)' },
];
const path = (k: 'arbiter' | 'xor4') => sim.attack.map((a, i) => `${i ? 'L' : 'M'}${x(a.crps)},${y(a[k])}`).join(' ');
const pct = (v: number) => `${(v * 100).toFixed(1)}%`;
const last = sim.attack[sim.attack.length - 1];
const colEdges = xs.map((n, i) => {
  const left = i === 0 ? x(n) - 20 : (x(xs[i - 1]) + x(n)) / 2;
  const right = i === xs.length - 1 ? x(n) + 20 : (x(n) + x(xs[i + 1])) / 2;
  return [left, right];
});
---
<figure class="figure viz">
  <ul class="viz-legend" aria-hidden="true">
    {series.map((s) => <li><i style={`background: ${s.color}`}></i>{s.name}</li>)}
  </ul>
  <div class="dg-scroll"><svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="atk-title atk-desc">
    <title id="atk-title">Machine-learning attack accuracy vs collected CRPs</title>
    <desc id="atk-desc">Logistic regression predicts an arbiter PUF with {pct(last.arbiter)} accuracy after {last.crps} challenge-response pairs, but stays near 50% on a 4-XOR arbiter PUF.</desc>
    {[0.4, 0.5, 0.6, 0.7, 0.8, 0.9, 1].map((t) => (
      <g>
        <line class={t === 0.4 ? 'base' : 'grid'} x1={L} x2={L + pw} y1={y(t)} y2={y(t)} />
        <text x={L - 8} y={y(t) + 4} text-anchor="end">{Math.round(t * 100)}%</text>
      </g>
    ))}
    {xs.map((n) => <text x={x(n)} y={T + ph + 20} text-anchor="middle">{n >= 1000 ? `${n / 1000}k` : n}</text>)}
    <text class="axis-title" x={L + pw / 2} y={H - 8} text-anchor="middle">Challenge–response pairs the attacker collected (log scale)</text>
    <text class="axis-title" x={L} y={12}>Prediction accuracy on unseen challenges</text>

    <line class="ref" x1={L} x2={L + pw} y1={y(0.5)} y2={y(0.5)} />
    <text x={L + pw - 4} y={y(0.5) + 18} text-anchor="end">coin flip</text>

    {series.map((s) => <path d={path(s.key)} fill="none" style={`stroke: ${s.color}`} stroke-width="2" stroke-linejoin="round" />)}
    {series.map((s) => sim.attack.map((a) => <circle cx={x(a.crps)} cy={y(a[s.key])} r="4.5" style={`fill: ${s.color}; stroke: var(--surface)`} stroke-width="2" />))}
    <text class="direct" x={x(last.crps) + 12} y={y(last.arbiter) + 4}>Arbiter</text>
    <text class="direct" x={x(last.crps) + 12} y={y(last.xor4) + 4}>4-XOR</text>

    {sim.attack.map((a, i) => (
      <g>
        <rect class="hit" role="img" tabindex="0" x={colEdges[i][0]} y={T} width={colEdges[i][1] - colEdges[i][0]} height={ph}
          data-tip={`<b>${a.crps.toLocaleString('en')} CRPs</b><br/>Arbiter: ${pct(a.arbiter)}<br/>4-XOR: ${pct(a.xor4)}`}
          aria-label={`${a.crps} CRPs: arbiter ${pct(a.arbiter)}, 4-XOR ${pct(a.xor4)}`} />
        <line class="hl" x1={x(a.crps)} x2={x(a.crps)} y1={T} y2={T + ph} />
      </g>
    ))}
  </svg></div>
  <details class="viz-table">
    <summary>Show the numbers</summary>
    <table>
      <thead><tr><th>CRPs collected</th><th>Arbiter PUF</th><th>4-XOR arbiter PUF</th></tr></thead>
      <tbody>{sim.attack.map((a) => <tr><td>{a.crps.toLocaleString('en')}</td><td>{pct(a.arbiter)}</td><td>{pct(a.xor4)}</td></tr>)}</tbody>
    </table>
  </details>
  <figcaption><strong>Logistic regression on the parity features Φ(c), tested on 3,000 fresh challenges.</strong> A few hundred eavesdropped pairs are enough to clone a plain arbiter PUF in software. XOR-ing four chains defeats this linear attack, although stronger attacks (more CRPs, neural networks, side channels) can still succeed.</figcaption>
</figure>

<script>
  import { bindTooltips } from '../../scripts/viz';
  bindTooltips();
</script>
