---
// Three 8×8 SRAM power-up maps: chip A, chip A again (noisy cells ringed), chip B. viewBox 1000×360.
let seed = 7;
const rnd = () => { seed = (seed * 1103515245 + 12345) & 0x7fffffff; return seed / 0x7fffffff; };
const a = Array.from({ length: 64 }, () => (rnd() < 0.5 ? 1 : 0));
const noisy = new Set([9, 30, 51]);
const a2 = a.map((v, i) => (noisy.has(i) ? 1 - v : v));
const b = Array.from({ length: 64 }, () => (rnd() < 0.5 ? 1 : 0));
const diffB = a.reduce((s, v, i) => s + (v !== b[i] ? 1 : 0), 0);
const panels = [
  { x: 52, title: 'Chip A, power-up 1', note: 'reference fingerprint', bits: a, ring: new Set<number>() },
  { x: 388, title: 'Chip A, power-up 2', note: `${noisy.size} of 64 bits flipped`, bits: a2, ring: noisy },
  { x: 724, title: 'Chip B, power-up', note: `${diffB} of 64 bits differ from A`, bits: b, ring: new Set<number>() },
];
const C = 26, G = 2;
---
<figure class="figure">
  <p class="dg-hint">Scroll sideways to see the whole diagram.</p>
  <div class="dg-scroll">
    <svg class="dg" viewBox="0 0 1000 360" role="img" aria-labelledby="sram-title sram-desc">
      <title id="sram-title">SRAM power-up states as fingerprints</title>
      <desc id="sram-desc">Chip A powers up to almost the same pattern twice, with {noisy.size} of 64 cells flipping because of noise, while chip B's pattern differs from chip A in {diffB} of 64 cells.</desc>
      {panels.map((p) => (
        <g>
          <text class="name" x={p.x + 112} y="34" text-anchor="middle">{p.title}</text>
          {p.bits.map((v, i) => {
            const cx = p.x + (i % 8) * (C + G), cy = 54 + Math.floor(i / 8) * (C + G);
            return <rect x={cx} y={cy} width={C} height={C} rx="6" style={v ? 'fill: var(--primary)' : 'fill: var(--surface-2); stroke: color-mix(in srgb, var(--ink) 18%, transparent)'} stroke-width="1" />;
          })}
          {[...p.ring].map((i) => <rect x={p.x + (i % 8) * (C + G) - 3} y={54 + Math.floor(i / 8) * (C + G) - 3} width={C + 6} height={C + 6} rx="8" fill="none" style="stroke: var(--butter)" stroke-width="3.5" />)}
          <text class="sub" x={p.x + 112} y="304" text-anchor="middle">{p.note}</text>
        </g>
      ))}
      <g transform="translate(330 338)">
        <rect x="0" y="-11" width="14" height="14" rx="4" style="fill: var(--primary)" /><text class="sub" x="22" y="1">cell wakes up as 1</text>
        <rect x="170" y="-11" width="14" height="14" rx="4" style="fill: var(--surface-2); stroke: color-mix(in srgb, var(--ink) 25%, transparent)" /><text class="sub" x="192" y="1">cell wakes up as 0</text>
      </g>
    </svg>
  </div>
  <figcaption><strong>No extra circuit needed.</strong> Each SRAM cell is two cross-coupled inverters. At power-up, tiny transistor mismatches tip each cell to 0 or 1, the same way on most boots, but differently on every chip.</figcaption>
</figure>
