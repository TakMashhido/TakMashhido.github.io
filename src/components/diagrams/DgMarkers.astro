---
interface Props { id: string }
const { id } = Astro.props;
---
<defs>
  <marker id={`${id}-arrow`} markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto"><path class="mk" d="M0,0 L10,4 L0,8 Z" /></marker>
  <marker id={`${id}-acc`} markerUnits="userSpaceOnUse" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto"><path class="mk-acc" d="M0,0 L10,4 L0,8 Z" /></marker>
</defs>
