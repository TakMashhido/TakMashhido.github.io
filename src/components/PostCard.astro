---
import ClayArt from './ClayArt.astro';
import { artFor, formatDate, readingTime, slugifyTag, type Post } from '../scripts/blog';
interface Props { post: Post }
const { post } = Astro.props;
const { title, description, date, category, tags, demo, cover, coverAlt } = post.data;
const art = artFor(post);
const mins = readingTime(post.body);
const search = `${title} ${description} ${tags.join(' ')} ${category}`.toLowerCase();
---
<article class="card clay" data-search={search} data-tags={tags.map(slugifyTag).join(' ')} data-category={category}>
  <div class={`cover cover-${category.toLowerCase()}`}>
    {cover ? <img src={cover} alt={coverAlt ?? ''} loading="lazy" decoding="async" /> : <div class="cover-art"><ClayArt name={art} /></div>}
  </div>
  <div class="top">
    <span class={`chip ${category === 'Research' ? 'tag-mint' : 'tag-butter'}`}>{category}</span>
    {demo && <span class="chip">Demo</span>}
  </div>
  <h3><a href={`/blog/${post.id}/`}>{title}</a></h3>
  <p class="muted">{description}</p>
  <p class="info"><time datetime={date.toISOString()}>{formatDate(date)}</time>, {mins} min read</p>
  {tags.length > 0 && (
    <ul class="tags">
      {tags.map((t) => <li><a href={`/blog/tags/${slugifyTag(t)}/`}>#{t}</a></li>)}
    </ul>
  )}
</article>

<style>
  .card { position: relative; padding: clamp(20px, 3vw, 30px); border-radius: var(--r-lg) var(--r-lg) var(--r-lg) var(--r-sm); display: flex; flex-direction: column; }
  .cover { margin: -6px -6px 18px; border-radius: calc(var(--r-lg) - 8px); aspect-ratio: 16 / 9; overflow: hidden; display: grid; place-items: center; box-shadow: var(--clay-pressed); }
  .cover-research { background: color-mix(in srgb, var(--mint) 28%, var(--surface-2)); }
  .cover-technical { background: color-mix(in srgb, var(--butter) 28%, var(--surface-2)); }
  .cover img { width: 100%; height: 100%; object-fit: cover; }
  .cover-art { width: 46%; max-width: 170px; }
  .top { display: flex; gap: 8px; margin-bottom: 14px; }
  h3 { font-size: var(--step-1); }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  h3 a:focus-visible { outline: none; }
  .card:has(h3 a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 4px; }
  .card:hover h3 a { color: var(--primary); }
  .info { margin: auto 0 10px; font-size: var(--step--1); font-weight: 600; color: var(--ink-soft); }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 4px 12px; position: relative; z-index: 1; }
  .tags a { font-size: var(--step--1); font-weight: 600; text-decoration: none; }
</style>
