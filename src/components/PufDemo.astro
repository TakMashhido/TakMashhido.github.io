---
const N = 16;
---
<section class="puf clay" aria-labelledby="puf-title">
  <div class="puf-intro">
    <h2 id="puf-title">Two identical chips, two different fingerprints</h2>
    <p class="muted">
      A physical unclonable function (PUF) turns microscopic manufacturing differences into a response nobody can copy.
      Set a challenge, then ask two chips made from the same design. This demo runs a simulated arbiter PUF in your browser.
    </p>
  </div>

  <div class="rows">
    <div class="row">
      <span class="row-label" id="ch-label">Challenge</span>
      <div class="bits" role="group" aria-labelledby="ch-label">
        {Array.from({ length: N }, (_, i) => (
          <button type="button" class="bit bit-toggle" data-i={i} aria-pressed="false" aria-label={`Challenge bit ${i + 1}`}>0</button>
        ))}
      </div>
    </div>

    <div class="actions">
      <button type="button" class="btn btn-sm" id="puf-random">Random challenge</button>
      <button type="button" class="btn btn-primary btn-sm" id="puf-query">Ask both chips</button>
    </div>

    <div class="row">
      <span class="row-label">Chip A</span>
      <div class="bits out" id="resp-a" aria-live="polite">
        {Array.from({ length: N }, () => <span class="bit empty">·</span>)}
      </div>
    </div>
    <div class="row">
      <span class="row-label">Chip B</span>
      <div class="bits out" id="resp-b">
        {Array.from({ length: N }, () => <span class="bit empty">·</span>)}
      </div>
    </div>
  </div>

  <p class="verdict" id="puf-verdict" aria-live="polite">Responses appear here. Bits where the chips disagree get a butter-yellow ring.</p>
</section>

<style is:global>
  .puf { padding: clamp(22px, 4vw, 44px); border-radius: var(--r-xl); display: grid; gap: 22px 48px; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); align-items: center; }
  .puf h2 { font-size: var(--step-2); }
  .puf-intro p { margin: 0; max-width: 46ch; }
  .puf .rows { display: grid; gap: 14px; min-width: 0; }
  .puf .row { display: grid; grid-template-columns: 92px minmax(0, 1fr); align-items: center; gap: 12px; }
  .puf .row-label { font-weight: 700; font-size: var(--step--1); color: var(--ink-soft); }
  .puf .bits { display: grid; grid-template-columns: repeat(16, minmax(0, 1fr)); gap: 6px; }
  .puf .bit {
    display: grid; place-items: center; aspect-ratio: 1 / 1.25; min-width: 0;
    border: 0; border-radius: 10px; padding: 0;
    background: var(--surface-2); box-shadow: var(--clay-pressed);
    font: 700 0.85rem/1 var(--font-code); color: var(--ink-soft);
    transition: background .2s ease, box-shadow .2s ease, transform .2s ease;
  }
  .puf .bit-toggle { cursor: pointer; }
  .puf .bit[aria-pressed='true'], .puf .bit.one { background: var(--mint); color: var(--mint-ink); box-shadow: var(--clay-sm); }
  .puf .bit.zero { background: var(--surface); color: var(--ink); box-shadow: var(--clay-sm); }
  .puf .bit.diff { outline: 3px solid var(--butter); outline-offset: 1px; }
  .puf .bit.empty { opacity: .6; }
  .puf .actions { display: flex; flex-wrap: wrap; gap: 10px; padding-left: 104px; }
  .puf .verdict { grid-column: 1 / -1; margin: 0; padding: 14px 18px; border-radius: var(--r-md); background: var(--surface-2); box-shadow: var(--clay-pressed); font-weight: 600; }

  @media (max-width: 960px) {
    .puf { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .puf .row { grid-template-columns: 1fr; gap: 6px; }
    .puf .actions { padding-left: 0; }
    .puf .bits { grid-template-columns: repeat(8, minmax(0, 1fr)); }
    .puf .bit { aspect-ratio: 1 / 1; }
  }
</style>

<script>
  const N = 16;

  // Deterministic PRNG so each simulated chip keeps the same "silicon" on every visit.
  function mulberry32(seed: number) {
    return () => {
      seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function gaussian(rand: () => number) {
    const u = Math.max(rand(), 1e-9), v = rand();
    return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
  }
  // A chip = N independent arbiter PUFs (one per response bit), each with N+1 delay weights.
  function makeChip(seed: number) {
    const rand = mulberry32(seed);
    return Array.from({ length: N }, () => Array.from({ length: N + 1 }, () => gaussian(rand)));
  }
  // Standard additive delay model: feature vector phi_i = prod_{j>=i} (1 - 2c_j).
  function features(c: number[]) {
    const phi = new Array(N + 1).fill(1);
    for (let i = N - 1; i >= 0; i--) phi[i] = phi[i + 1] * (1 - 2 * c[i]);
    return phi;
  }
  // Each response bit sees the challenge through its own fixed permutation, like an XOR/feed-forward variant.
  function permute(c: number[], k: number) {
    return c.map((_, i) => c[(i * 5 + k * 3) % N] ^ (((i + k) % 3 === 0) ? 1 : 0));
  }
  function respond(chip: number[][], c: number[]) {
    return chip.map((w, k) => {
      const phi = features(permute(c, k));
      const delta = w.reduce((s, wi, i) => s + wi * phi[i], 0);
      return delta > 0 ? 1 : 0;
    });
  }

  const chipA = makeChip(0x4b4d); // "KM"
  const chipB = makeChip(0x2026);

  const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>('.bit-toggle'));
  const outA = document.getElementById('resp-a')!;
  const outB = document.getElementById('resp-b')!;
  const verdict = document.getElementById('puf-verdict')!;

  const challenge = () => toggles.map((b) => (b.getAttribute('aria-pressed') === 'true' ? 1 : 0));
  const setBit = (b: HTMLButtonElement, v: number) => { b.setAttribute('aria-pressed', String(!!v)); b.textContent = String(v); };

  toggles.forEach((b) => b.addEventListener('click', () => setBit(b, b.getAttribute('aria-pressed') === 'true' ? 0 : 1)));

  function render(el: HTMLElement, bits: number[], other: number[]) {
    el.innerHTML = '';
    bits.forEach((v, i) => {
      const s = document.createElement('span');
      s.className = `bit ${v ? 'one' : 'zero'}${v !== other[i] ? ' diff' : ''}`;
      s.textContent = String(v);
      el.appendChild(s);
    });
    el.setAttribute('aria-label', bits.join(''));
  }

  function query() {
    const c = challenge();
    const a = respond(chipA, c), b = respond(chipB, c);
    render(outA, a, b); render(outB, b, a);
    const hd = a.reduce((s, v, i) => s + (v !== b[i] ? 1 : 0), 0);
    const pct = Math.round((hd / N) * 100);
    verdict.textContent = `The chips disagree on ${hd} of ${N} bits (${pct}%). An ideal PUF pair disagrees on about 50%, and asking Chip A again always gives the same answer.`;
  }

  document.getElementById('puf-query')?.addEventListener('click', query);
  document.getElementById('puf-random')?.addEventListener('click', () => {
    const r = crypto.getRandomValues(new Uint8Array(N));
    toggles.forEach((b, i) => setBit(b, r[i] & 1));
    query();
  });
</script>
